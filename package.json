{
  "name": "forgerie",
  "version": "1.202608.0",
  "private": true,
  "description": "Browser control surface for persistent Pi Coding Agent sessions.",
  "license": "MIT",
  "author": "Simon W. Jackson",
  "contributors": [
    "Federico Jaramillo Martinez"
  ],
  "type": "module",
  "bin": {
    "forgerie": "dist/cli.js",
    "forgerie-server": "dist/server/index.js",
    "forgerie-sessiond": "dist/server/sessiond.js"
  },
  "files": [
    "dist",
    "!dist/**/*.testSupport.*",
    "README.md",
    "LICENSE",
    "flake.nix",
    "flake.lock",
    "nix",
    "speech",
    "extensions",
    "skills",
    "agents",
    "docs/plugins.md",
    "docs/decision-hints.md",
    "docs/config.md",
    "docs/deployment.md",
    "docs/session-worktrees.md",
    "docs/workflows.md",
    "docs/triggers.md",
    "docs/web-search.md",
    "docs/fork-cleanup.md"
  ],
  "bundleDependencies": [
    "pi-web-access",
    "@earendil-works/pi-coding-agent",
    "@router-for-me/pi-cliproxyapi-provider",
    "typebox"
  ],
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" EXIT; npm run dev:sessiond & npm run dev:web & npm run dev:client & wait'",
    "dev:sessiond": "tsx watch src/server/sessiond.ts",
    "dev:web": "tsx watch src/server/index.ts",
    "dev:server": "npm run dev:web",
    "dev:client": "npm --prefix ui run dev",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:ui",
    "build:ui": "npm --prefix ui run build",
    "typecheck": "tsc --noEmit",
    "typecheck:cached": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/forgerie/typecheck.tsbuildinfo",
    "knip": "knip",
    "lint": "eslint \"src/**/*.ts\" \"extensions/**/*.ts\" vitest.config.ts",
    "audit:grid-stretch": "node scripts/audit-grid-stretch.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:related": "vitest related --run --config vitest.config.ts --passWithNoTests",
    "test:changed": "node scripts/test-changed.mjs",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --maxWorkers=4",
    "verify:static": "npm run typecheck && npm run lint && npm run knip && npm run knip:ui",
    "verify": "npm run verify:static && npm test && npm run verify:ui",
    "verify:ui": "npm --prefix ui run verify",
    "verify:staged": "node scripts/verify-staged.mjs",
    "start": "tsx src/server/index.ts",
    "start:sessiond": "tsx src/server/sessiond.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "smoke:package-install": "node scripts/smoke-package-install.mjs",
    "prepare": "node scripts/install-git-hooks.mjs && node -e \"if (require('node:fs').existsSync('ui/package.json')) require('node:child_process').execSync('npm --prefix ui ci --no-audit --no-fund', { stdio: 'inherit' })\"",
    "changeset": "changeset",
    "release:version": "changeset version",
    "changelog:status": "changeset status",
    "repair:spawn-marks": "tsx scripts/repair-agent-spawned.ts",
    "knip:ui": "knip --directory ui"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@fastify/compress": "^9.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@router-for-me/pi-cliproxyapi-provider": "1.4.21",
    "diff": "^9.0.0",
    "fastify": "^5.10.0",
    "html-to-text": "9.0.5",
    "pi-web-access": "0.39.0",
    "proper-lockfile": "^4.1.2",
    "typebox": "1.3.7",
    "undici": "^8.11.2",
    "ws": "^8.21.0",
    "yaml": "2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/html-to-text": "9.0.4",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.25.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "os": [
    "!win32"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.11.0",
  "keywords": [
    "pi-package",
    "pi",
    "forgerie",
    "pi-coding-agent",
    "pi-coding-agent-web-ui",
    "coding-agent",
    "ai-coding-agent",
    "agentic-development",
    "developer-tools",
    "web-ui",
    "webui",
    "browser-ui",
    "remote-development",
    "persistent-sessions"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
