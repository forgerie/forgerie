{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli.ts",
    "src/server/workspaces/workspaceServicesRunner.ts",
    "extensions/forgerie.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "extensions/**/*.ts"
  ],
  "ignoreBinaries": [
    "findmnt",
    "flock",
    "nix",
    "ps",
    "setsid"
  ],
  "ignoreExportsUsedInFile": true,
  "vitest": {
    "config": [
      "vitest.config.ts"
    ],
    "entry": [
      "src/**/*.test.ts",
      "scripts/**/*.test.mjs"
    ]
  }
}
