{
  "name": "forgerie-assistant-ui-mvp",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 8510 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:workflow-browser": "node scripts/verify-workflow-sheet.mjs",
    "lint": "eslint src gates",
    "verify": "npm run build && npm run lint && npm test",
    "gates": "vitest run gates",
    "gates:record": "GATES_RECORD=1 vitest run gates --no-file-parallelism"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-streamdown": "^0.3.17",
    "@assistant-ui/tap": "0.9.19",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "diff": "9.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.6.0",
    "typebox": "^1.3.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@simonwjackson/caliper": "0.1.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.59.1",
    "react-markdown": "^10.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
